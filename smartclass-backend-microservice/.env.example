# 复制为 .env 后填写；compose 中标记 :? 的变量缺失会直接报错
# MySQL root 密码（必填，仅绑定 127.0.0.1）
MYSQL_ROOT_PASSWORD=change_me_mysql_root

# JWT 签名密钥（必填，不少于 32 字节；网关与 user 服务共用）
JWT_SECRET=change_me_at_least_32_bytes_long_secret

# 网关/Feign 内部调用令牌（必填，任意随机串；用于服务间跳过鉴权的凭证）
INTERNAL_CALL_TOKEN=change_me_random_internal_token

# Redis 密码（可为空）
REDIS_PASSWORD=

# 模拟支付开关（默认 false；仅本地 dev/test 开启，生产必须走渠道回调验签）
PAY_MOCK_ENABLED=false
