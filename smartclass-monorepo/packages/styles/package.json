{
  "name": "@smartclass/styles",
  "version": "1.0.0",
  "description": "智云星课共享样式系统",
  "main": "dist/index.css",
  "module": "dist/index.css",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    },
    "./variables.css": {
      "types": "./dist/variables.css.d.ts",
      "import": "./dist/variables.css",
      "require": "./dist/variables.css"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs",
    "lint": "stylelint src/**/*.css"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@smartclass/config": "workspace:*",
    "postcss": "^8.4.41",
    "postcss-nested": "^6.2.0",
    "stylelint": "^16.8.0",
    "stylelint-config-standard": "^36.0.0",
    "vite": "^5.4.0"
  }
}
