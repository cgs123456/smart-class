{
  "name": "smartclass-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "智云星课前端 Monorepo",
  "scripts": {
    "dev:mobile": "pnpm --filter @smartclass/mobile dev",
    "dev:admin": "pnpm --filter @smartclass/admin dev",
    "build:all": "pnpm -r run build",
    "build:mobile": "pnpm --filter @smartclass/mobile build",
    "build:admin": "pnpm --filter @smartclass/admin build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "generate:api": "pnpm --filter @smartclass/api run generate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky install",
    "sync:versions": "node tools/sync-versions.js",
    "turbo:build": "turbo run build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.6.0",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "overrides": {
      "vue": "^3.4.38",
      "vue-router": "^4.4.3",
      "pinia": "^2.1.7",
      "axios": "^1.7.2",
      "@vueuse/core": "^10.11.0"
    }
  }
}