{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vite/build/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "generate:api": {
      "cache": false,
      "outputs": ["packages/api/src/generated/**"]
    },
    "release": {
      "dependsOn": ["build", "lint", "typecheck", "test"],
      "cache": false
    }
  },
  "globalEnv": ["NODE_ENV", "VITE_APP_TITLE", "VITE_API_BASE_URL"]
}
